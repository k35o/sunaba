{
  "name": "sunaba",
  "version": "0.0.0",
  "description": "AI-native component workbench for React",
  "keywords": [],
  "homepage": "https://github.com/k35o/sunaba#readme",
  "bugs": "https://github.com/k35o/sunaba/issues",
  "license": "MIT",
  "author": "k8o (https://github.com/k35o)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k35o/sunaba.git",
    "directory": "packages/sunaba"
  },
  "bin": {
    "sunaba": "./dist/cli/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.mts",
        "default": "./dist/react/index.mjs"
      }
    },
    "./stage": {
      "import": {
        "types": "./dist/runtime/stage.d.mts",
        "default": "./dist/runtime/stage.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp check",
    "check:write": "vp check --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hono/mcp": "0.3.1",
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.3",
    "hono": "4.13.1",
    "oxc-parser": "0.144.0",
    "tinyglobby": "0.2.17",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@k8o/oxc-config": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "8.18.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "vite": "^8"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
